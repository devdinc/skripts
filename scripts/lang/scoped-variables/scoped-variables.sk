import:
    ch.njol.skript.log.SkriptLogger
    ch.njol.skript.lang.Variable
    ch.njol.skript.Skript

# script's parent folder, relative to /scripts
local function scopeFolder(origin: object) :: string:
    set {_scriptsFolder} to Skript.getInstance().getScriptsFolder().toPath().toAbsolutePath()
    set {_scriptParent} to {_origin}.getConfig().getPath().getParent().toAbsolutePath()
    set {_relative} to {_scriptsFolder}.relativize({_scriptParent})
    set {_folder} to {_relative}.toString().replace("\\", "/")
    return {_folder}

effect set default scope for scoped variables in current script to (a:current (x:folder|x:package|y:script)|b:(folder|package) %-string%|c: %-script%):
    parse:
        set {_sv::origin} to SkriptLogger.getNode()
        set {_sv::script} to script ({_sv::origin}.getConfig().getFileName())
        continue
    trigger:
        if parse tags contains "a":
            if parse tags contains "x":
                set {-scoped.sk::default_scope::%{_sv::script}%} to scopeFolder({_sv::origin})
            else if parse tags contains "y":
                set {-scoped.sk::default_scope::%{_sv::script}%} to {_sv::script}
        else if parse tags contains "b":
            set {-scoped.sk::default_scope::%{_sv::script}%} to expr-1
        else if parse tags contains "c":
            set {-scoped.sk::default_scope::%{_sv::script}%} to expr-2

# returns [1] the variable prefix ("_", "-" or ""), [2] "<scope>::<name>[::*]"
local function scoped_ctx(origin: object, event: object, var: object, script: object, mark: number) :: strings:
    set {_realscript} to script ({_origin}.getConfig().getFileName())

    if {_mark} is 0:
        set {_scope} to {-scoped.sk::default_scope::%{_realscript}%}
        if {_scope} is not set:
            set {_scope} to {_realscript}
    else if {_mark} is 1:
        set {_scope} to {_script}
    else if {_mark} is 2:
        set {_scope} to scopeFolder({_origin})

    set {_prefix} to ""
    set {_suffix} to ""
    if {_var}.isLocal() is true:
        set {_prefix} to "_"
    if {_var}.isEphemeral() is true:
        set {_prefix} to "-"
    if {_var}.isList() is true:
        set {_suffix} to "::*"

    set {_name} to {_var}.getName().toUnformattedString({_event})
    replace "::*" with "" in {_name}

    set {_ret::1} to {_prefix}
    set {_ret::2} to "%{_scope}%::%{_name}%%{_suffix}%"
    return {_ret::*}

expression scoped [variable] %$objects% [([with]in|from|by) (1:%-script%|2:current (folder|package))]:
    parse:
        expr-1 is an instance of Variable
        set {_sv::var} to expr-1
        # captures the backing expression's script
        set {_sv::origin} to SkriptLogger.getNode()
        continue

    get:
        suppress starting with expression warnings
        set {_sv::ctx::*} to scoped_ctx({_sv::origin}, event, {_sv::var}, expr-2, parse mark)
        return variable "%{_sv::ctx::1}%scoped::%{_sv::ctx::2}%" with custom-event event

    set:
        set {_sv::ctx::*} to scoped_ctx({_sv::origin}, event, {_sv::var}, expr-2, parse mark)
        set variable "%{_sv::ctx::1}%scoped::%{_sv::ctx::2}%" with custom-event event to change values

    add:
        set {_sv::ctx::*} to scoped_ctx({_sv::origin}, event, {_sv::var}, expr-2, parse mark)
        add change values to variable "%{_sv::ctx::1}%scoped::%{_sv::ctx::2}%" with custom-event event

    remove:
        set {_sv::ctx::*} to scoped_ctx({_sv::origin}, event, {_sv::var}, expr-2, parse mark)
        remove change values from variable "%{_sv::ctx::1}%scoped::%{_sv::ctx::2}%" with custom-event event

    remove all:
        set {_sv::ctx::*} to scoped_ctx({_sv::origin}, event, {_sv::var}, expr-2, parse mark)
        remove all change values from variable "%{_sv::ctx::1}%scoped::%{_sv::ctx::2}%" with custom-event event

    delete:
        set {_sv::ctx::*} to scoped_ctx({_sv::origin}, event, {_sv::var}, expr-2, parse mark)
        delete variable "%{_sv::ctx::1}%scoped::%{_sv::ctx::2}%" with custom-event event

    reset:
        set {_sv::ctx::*} to scoped_ctx({_sv::origin}, event, {_sv::var}, expr-2, parse mark)
        delete variable "%{_sv::ctx::1}%scoped::%{_sv::ctx::2}%" with custom-event event
