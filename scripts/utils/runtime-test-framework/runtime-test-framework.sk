import:
    ch.njol.skript.lang.parser.ParserInstance
    ch.njol.skript.lang.Condition
    ch.njol.skript.log.SkriptLogger
    ch.njol.skript.ScriptLoader
    java.lang.Runnable
    net.minestom.server.MinecraftServer

options:
    hidden: f39f0f4a-31ee-4b71-87e9-38ddba3a2313 # id of the hidden bootstrap test

# Minestom port notes
# - there is no `script` type, so a script is identified by the hash of its file name (a number).
#   it is carried in events as the `number` event value ( string = test name, boolean = autorun, number = script id )
#   and stored as [name, scriptId] in the test registry.
# - there is no TestTracker / TestOfflinePlayer, and no world / location / offline player fixtures.
# - no command either

local function testLog(msg: string):
    send "[<gold>Skript<reset>] %{_msg}%" to console

# reports + records a failure of the test the given event belongs to
# tags: the effect's parse tags ("5" = no error message)
local function recordTestFailure(event: object, detail: string, err: string, tags: strings):
    set {_test} to {_event}.getEventValue("string")
    set {_sid} to {_event}.getEventValue("number")
    set {_text} to "Test ""%{_test}%""%{_detail}% failed"
    if {_tags::*} does not contain "5":
        set {_msg} to " %{_err}%" if {_err} is set else ""
        testLog("[&cTEST FAILURE<reset>] %{_text}%%{_msg}%")
    add "%{_err}%" to {-test.sk::errors::%{_sid}%.%{_test}%::*}

event "skriptTest":
    pattern: [devdinc] test %string% [when <(.+)>]
    event-values: string, boolean
    parse:
        set {_origin} to SkriptLogger.getNode()
        set {_scriptid} to {_origin}.getConfig().getFileName().hashCode()

        # we don't have access to event-string or expr-1, so we can't run it in parse time.
        # one thing we can do is cause a call to event to register tho.
        set {_list::string} to "{@hidden}"
        set {_list::boolean} to false
        create section with {_proxy} stored in {_functions::run}:
            wait 2 ticks
            call custom event "skriptTest" with {_list::*}
        set {_proxy} to new proxy instance of Runnable using {_functions::*}
        MinecraftServer.getSchedulerManager().scheduleNextTick({_proxy})
        continue
    check:
        set {_scriptid} to 0 if {_scriptid} is not set # parse section didn't run
        set {_ok} to true
        set {-test.sk::tests::%{_scriptid}%.%expr-1%} to ["%expr-1%", {_scriptid}] # registering
        if "%expr-1%" is event-string:
            set {_raw} to first element of regex-1
            if {_raw} is set:
                set {_cond} to Condition.parse({_raw}, "Can't understand condition: " + {_raw})
            if {_cond} is set:
                set {_ok} to {_cond}.check(event)
            if {_ok} is true:
                testLog("Running test case %expr-1%")
                continue

event "beforeSkriptTest":
    pattern: [devdinc] before each test
    event-values: string, boolean, number
    check:
        continue

event "afterSkriptTest":
    pattern: [devdinc] after each test
    event-values: string, boolean, number
    check:
        continue

event "beforeSkriptTestAll":
    pattern: [devdinc] before all tests
    event-values: number
    check:
        continue

event "afterSkriptTestAll":
    pattern: [devdinc] after all tests
    event-values: number
    check:
        continue

before each test:
    delete {-test.sk::errors::%event-number%.%event-string%::*}

on load:
    delete {-test.sk::*}
    wait 1 tick
    set {_list::string} to "{@hidden}"
    set {_list::boolean} to false
    call custom event "skriptTest" with {_list::*}
    wait 1 tick
    set {_tests::*} to all tests
    autorun {_tests::*}

# `in script` takes the script's file name, e.g. `all tests in script "tests/arithmetic.sk"`
plural expression [all] tests [[with] [test] [name] %-string%] [in script %-string%]:
    get:
        if expr-2 is set:
            set {_sid} to expr-2.hashCode()
        loop {-test.sk::tests::*}:
            if expr-2 is set:
                if loop-value[1] is not {_sid}:
                    continue loop
            if expr-1 is set:
                if loop-value[0] is not expr-1:
                    continue loop
            add loop-value to {_r::*}
        return {_r::*}

effect [devdinc] (1:|2:auto)run %objects%:
    trigger:
        set {_tests::*} to expr-1
        set {_alltests::*} to all tests
        loop {_tests::*}:
            set {_list::number} to loop-value[1]
            if {_scripts::*} does not contain {_list::number}:
                add {_list::number} to {_scripts::*}
                call custom event "beforeSkriptTestAll" with {_list::*}
        loop {_tests::*}:
            set {_list::string} to loop-value[0]
            set {_list::number} to loop-value[1]
            set {_list::boolean} to true if parse mark is 2 else false
            call custom event "beforeSkriptTest" with {_list::*}
            call custom event "skriptTest" with {_list::*}
            call custom event "afterSkriptTest" with {_list::*}
            if any:
                {_list::string} contains "{@hidden}"
                size of ({_alltests::*} where ["%input%" is "%loop-value%"]) is 0
            then:
                add 1 to {_forgottenTestResults}
                continue loop
            add 1 to {_testFails} if size of {-test.sk::errors::%{_list::number}%.%{_list::string}%::*} is greater than 0
        loop {_scripts::*}:
            set {_list::number} to loop-value
            call custom event "afterSkriptTestAll" with {_list::*}
        set {_validTestAmount} to size of {_tests::*} - {_forgottenTestResults}
        if {_validTestAmount} is not 0:
            testLog("<yellow>%{_validTestAmount} - {_testFails}%/%{_validTestAmount}% tests passed.")
        else if size of {_alltests::*} is greater than 0: # skipping if there is no initial hidden test
            testLog("<yellow>No tests found.")

# tags: 1 = assert true, 2 = assert false / to fail, 3 = halt on failure, 4 = don't halt, 5 = no error message, 6 = error message
effect:
    patterns:
        (3:|4:(no|without) (halt[ing]|fail[(-| )](safe|fast)|abort[ing])) assert(1:|1: true|2: false)[ with (6:|5:no )[[error] message][ %-string%]]\: <(.+)>
        (3:|4:(no|without) (halt[ing]|fail[(-| )](safe|fast)|abort[ing])) assert <(.+)> (1:|2:to fail)[ with (6:|5:no )[[error][ message]][ %-string%]]
    usable in:
        custom event "skriptTest"
    parse:
        set {_tf::raw} to first element of regex-1

        # parse the condition as if inside a skriptTest event.
        # the parser is already on the right script (we're parsing one of its lines), so only the event is swapped.
        set {_tf::parser} to ParserInstance.get()
        set {_tf::parser}.[ParserInstance]isActive to true
        set {_tf::backup} to {_tf::parser}.backup()
        {_tf::parser}.setCurrentEvent("assert condition", (custom event "skriptTest").getClass())
        set {_tf::cond} to Condition.parse({_tf::raw}, "Can't understand condition: " + {_tf::raw})
        set {_tf::parser}.[ParserInstance]isActive to false
        {_tf::parser}.restoreBackup({_tf::backup})
        continue
    trigger:
        set {_tf::ok} to {_tf::cond}.check(event)
        set {_tf::expected} to true
        if parse tags contains "2":
            set {_tf::expected} to false
        if {_tf::ok} is not {_tf::expected}:
            set {_tf::label} to "assert true" if parse tags contains "1" else "assert false"
            recordTestFailure(event, " with condition '%{_tf::label}%: %{_tf::raw}%'", expr-1, parse tags)
            if parse tags contains "3":
                delay effect

effect (3:|4:(no|without) (halt[ing]|fail[(-| )](safe|fast)|abort[ing])) fail test[ with (6:|5:no )[[error] message][ %-string%]]:
    usable in:
        custom event "skriptTest"
    trigger:
        recordTestFailure(event, "", expr-1, parse tags)
        if parse tags contains "3":
            delay effect

effect stop auto [test] execution [here]:
    usable in:
        custom event "skriptTest"
    trigger:
        if event.getEventValue("boolean") is true:
            delay effect

expression event(-| )test:
    get:
        return [event.getEventValue("string"), event.getEventValue("number")]

condition event(-| )test (1:is|2:is not|2:isn't) autorun:
    check:
        set {_auto} to event.getEventValue("boolean")
        if {_auto} is true:
            if parse mark is 1:
                continue
        else if parse mark is 2:
            continue

condition last test result [of %-object%] is a (1:pass|2:fail):
    usable in:
        custom event "skriptTest"
    check:
        if expr-1 is not set:
            set {_test} to event.getEventValue("string")
            set {_sid} to event.getEventValue("number")
        else:
            set {_test} to expr-1[0]
            set {_sid} to expr-1[1]
            stop if size of (all tests where ["%input%" is "%expr-1%"]) is 0
        set {_errors} to size of {-test.sk::errors::%{_sid}%.%{_test}%::*}
        if parse mark is 1:
            if {_errors} <= 0:
                continue
        else if {_errors} > 0:
            continue

plural expression test errors[ for %-objects%]:
    return type: strings
    get:
        if expr-1 is not set:
            set {_test} to event.getEventValue("string")
            set {_sid} to event.getEventValue("number")
            return {-test.sk::errors::%{_sid}%.%{_test}%::*}
        loop ...expr-1:
            set {_test} to loop-value[0]
            set {_sid} to loop-value[1]
            add {-test.sk::errors::%{_sid}%.%{_test}%::*} to {_r::*}
        return {_r::*}

condition parse:
    parse:
        set {_parser} to ParserInstance.get()
        set {_parseSection} to {_parser}.getNode()
        set {_parseBackup} to {_parser}.backup()
        # nodes are not fully loaded here yet
        continue
    usable in:
        custom event "skriptTest"
    check:
        {_parser}.restoreBackup({_parseBackup})
        set {_logger} to SkriptLogger.startRetainingLog()
        ScriptLoader.loadItems({_parseSection})
        loop ...{_logger}.getLog():
            add loop-value.getMessage() to {_logs::*}
        set {-test.sk::latestLogs::*} to {_logs::*}
        {_logger}.close()
        {_parser}.reset()

plural expression (last|latest) parse logs:
    usable in:
        custom event "skriptTest"
    get:
        return {-test.sk::latestLogs::*}
