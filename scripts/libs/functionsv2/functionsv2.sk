import:
    java.util.function.Supplier
    java.util.function.Function
    java.util.function.Consumer
    java.util.function.BiFunction
    java.util.function.BiConsumer
    java.lang.Runnable
    java.util.ArrayList
    ch.njol.skript.lang.ExpressionList
    ch.njol.skript.lang.Variable
    ch.njol.skript.lang.Effect
    ch.njol.skript.lang.parser.ParserInstance
    ch.njol.skript.log.SkriptLogger
    ch.njol.skript.config.SectionNode
    ch.njol.skript.config.Node

local function extractArgs(vars: object) :: objects:
    if {_vars} is instance of ExpressionList:
        loop ...{_vars}.getExpressions():
            add loop-value to {_ret::*}
    else if {_vars} is instance of Variable:
        add {_vars} to {_ret::*}
    return {_ret::*}

local function isEffect(input: string) :: boolean:
    set {_log} to SkriptLogger.startRetainingLog()
    set {_effect} to Effect.parse({_input}, null)
    {_log}.clear()
    {_log}.close()
    return true if {_effect} is set else false

local function noReturnForMark(mark: number) :: boolean:
    return false if {_mark} is 1, 4 or 6 else true

local function arityOk(mark: number, n: number) :: boolean:
    if {_mark} is 1 or 2:
        return true if {_n} is 0 else false
    if {_mark} is 3 or 4:
        return true if {_n} > 0 else false
    return true if {_n} is 2 else false

local function walkNodes(n: object, list: object) :: objects:
    if {_list} is not set:
        set {_list} to new ArrayList()
    loop ...{_n}:
        {_list}.add(loop-value)
        if loop-value is instance of SectionNode:
            walkNodes(loop-value, {_list})
    return ...{_list}

local function blockLines(origin: object) :: strings:
    set {_oi} to {_origin}.[Node]getIndentation()
    set {_strip} to length of {_oi} + (4 if {_oi} starts with " " else 1)
    loop walkNodes({_origin}, {_none}):
        set {_line} to "%loop-value.[Node]getIndentation().substring({_strip})%%loop-value.getKey()%"
        if loop-value is instance of SectionNode:
            set {_line} to "%{_line}%:"
        add {_line} to {_lines::*}
    return {_lines::*}

local function runLambda(fn: object, args: objects) :: object:
    if {_fn} is instance of Runnable:
        {_fn}.run()
    else if {_fn} is instance of Consumer:
        {_fn}.accept({_args::1})
    else if {_fn} is instance of BiConsumer:
        {_fn}.accept({_args::1}, {_args::2})
    else if {_fn} is instance of Function:
        return {_fn}.apply({_args::1})
    else if {_fn} is instance of BiFunction:
        return {_fn}.apply({_args::1}, {_args::2})
    else if {_fn} is instance of Supplier:
        return {_fn}.get()

expression build lambda args %objects% body %strings% noreturn %boolean% script %script%:
    get:
        set {_fv2::args::*} to expr-1
        set {_fv2::arity} to size of {_fv2::args::*}
        set {_fv2::body::*} to expr-2
        if expr-3 is not true:
            if size of {_fv2::body::*} is 1:
                set {_fv2::body::*} to "return %{_fv2::body::*}%"
        set {_fv2::names::*} to "{_this}"
        loop {_fv2::args::*}:
            add "%loop-value%" to {_fv2::names::*}
        if expr-3 is true:
            set {_fv2::method} to "run" if {_fv2::arity} is 0 else "accept"
        else:
            set {_fv2::method} to "get" if {_fv2::arity} is 0 else "apply"
        set {_fv2::functions::%{_fv2::method}%} to line section {_fv2::body::*} with args {_fv2::names::*} in expr-4
        if expr-3 is true:
            if {_fv2::arity} is 0:
                return new proxy instance of Runnable using {_fv2::functions::*}
            else if {_fv2::arity} is 1:
                return new proxy instance of Consumer using {_fv2::functions::*}
            return new proxy instance of BiConsumer using {_fv2::functions::*}
        if {_fv2::arity} is 0:
            return new proxy instance of Supplier using {_fv2::functions::*}
        else if {_fv2::arity} is 1:
            return new proxy instance of Function using {_fv2::functions::*}
        return new proxy instance of BiFunction using {_fv2::functions::*}

expression:
    patterns:
        [new] lambda[ %-objects%]\:(1: |2:- |3:+ )<(.+)>
    parse:
        set {_fv2::expr} to first element of regex-1
        set {_fv2::noreturn} to isEffect({_fv2::expr}) if parse mark is 1
        set {_fv2::noreturn} to true if parse mark is 2
        set {_fv2::noreturn} to false if parse mark is 3
        set {_fv2::args::*} to extractArgs(expr-1)
        set {_fv2::script} to ParserInstance.get().getCurrentScript()
        continue
    get:
        return build lambda args {_fv2::args::*} body {_fv2::expr} noreturn {_fv2::noreturn} script {_fv2::script}

expression:
    patterns:
        [new] (1:supplier|1:getter|2:runnable|2:runner)[ %-objects%]\: <(.+)>
        [new] (3:consumer|3:accepter|4:function|4:applier|5:biconsumer|5:biaccepter|6:bifunction|6:biapplier) %-objects%\: <(.+)>
    parse:
        set {_fv2::args::*} to extractArgs(expr-1)
        if arityOk(parse mark, size of {_fv2::args::*}) is false:
            stop
        set {_fv2::expr} to first element of regex-1
        set {_fv2::noreturn} to noReturnForMark(parse mark)
        set {_fv2::script} to ParserInstance.get().getCurrentScript()
        continue
    get:
        return build lambda args {_fv2::args::*} body {_fv2::expr} noreturn {_fv2::noreturn} script {_fv2::script}

condition set %object% to [new] lambda[ %-objects%](1:|2:-|3:+):
    parse:
        set {_fv2::expr::*} to blockLines(SkriptLogger.getNode())
        set {_fv2::args::*} to extractArgs(expr-2)
        set {_fv2::script} to ParserInstance.get().getCurrentScript()
        loop {_fv2::expr::*}:
            loop-value.trim() starts with "return"
            set {_fv2::noreturn} to false if parse mark is 1
        set {_fv2::noreturn} to true if parse mark is 2
        set {_fv2::noreturn} to false if parse mark is 3
        continue
    check:
        set raw expression of expr-1 to build lambda args {_fv2::args::*} body {_fv2::expr::*} noreturn {_fv2::noreturn} script {_fv2::script}

condition set %object% to [new] (1:supplier|1:getter|2:runnable|2:runner|3:consumer|3:accepter|4:function|4:applier|5:biconsumer|5:biaccepter|6:bifunction|6:biapplier)[ %-objects%]:
    parse:
        set {_fv2::args::*} to extractArgs(expr-2)
        if arityOk(parse mark, size of {_fv2::args::*}) is false:
            stop
        set {_fv2::expr::*} to blockLines(SkriptLogger.getNode())
        set {_fv2::noreturn} to noReturnForMark(parse mark)
        set {_fv2::script} to ParserInstance.get().getCurrentScript()
        continue
    check:
        set raw expression of expr-1 to build lambda args {_fv2::args::*} body {_fv2::expr::*} noreturn {_fv2::noreturn} script {_fv2::script}

expression run[ lambda] %object%[ with %-objects%]:
    get:
        return runLambda(expr-1, expr-2)

effect run[ lambda] %object%[ with %-objects%]:
    trigger:
        runLambda(expr-1, expr-2)

effect return %object%:
    parse:
        set {_fv2::node} to SkriptLogger.getNode()
        if "%{_fv2::node}%" contains "lambda." or "supplier." or "applier." or "getter." or "function" or "bifunction" or "biapplier":
            continue
    trigger:
        broadcast "functionsv2.sk shouldn't ever run"
